{
    "file_format_version": "1.0.0",
    "layer": {
        "name": "VK_LAYER_CHROMA_layer",
        "type": "GLOBAL",
        "library_path": "@CHROMA_LAYER_PATH@",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "Chroma Vulkan Layer - Real-time Vibrance, Contrast, and Brightness adjustment",
        "functions": {
            "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
        },
        "enable_environment": {
            "ENABLE_CHROMA_LAYER": "1"
        },
        "disable_environment": {
            "DISABLE_CHROMA_LAYER": "1"
        }
    }
}
