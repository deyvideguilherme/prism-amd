pkgbase = prisma-control-center
	pkgdesc = Hardware display color calibration and telemetry for AMD GPUs on Noctalia Shell (Niri / Wayland)
	pkgver = 1.0.0
	pkgrel = 2
	url = https://github.com/deyvideguilherme/prism-amd
	install = prisma-control-center.install
	arch = x86_64
	license = MIT
	license = GPL-2.0-only
	makedepends = cmake
	makedepends = gcc
	makedepends = make
	depends = dkms
	depends = glibc
	depends = gcc-libs
	optdepends = noctalia: for the desktop control center visual plugin
	optdepends = linux-headers: to build the module for Arch Linux
	optdepends = linux-lts-headers: to build the module for Arch Linux LTS
	optdepends = linux-cachyos-headers: to build the module for CachyOS
	optdepends = linux-cachyos-lts-headers: to build the module for CachyOS LTS
	optdepends = clang: DKMS toolchain for kernels built with Clang
	optdepends = llvm: DKMS toolchain for kernels built with Clang
	optdepends = lld: DKMS linker for kernels built with Clang
	optdepends = pahole: external module BTF generation when the kernel headers require it
	provides = chroma-amd-dkms
	provides = prisma-ctl
	conflicts = chroma-amd-dkms

pkgname = prisma-control-center
